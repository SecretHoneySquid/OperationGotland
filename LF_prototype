#!/usr/bin/env python3
"""
Two-player production tug-of-war prototype.

You control both sides. Each player starts with 100 logistics health and a
balanced production mix that rolls up into a single production rate. Logistics
is a multiplier on every production type.

Front line logic:
  * Player 1 positioned at 0, Player 2 at 100.
  * Front line starts at 50 and is shown as the percentage
    (frontline - p1) / (p2 - p1).
  * Pressure is built from armor/infantry/air advantages (mitigated by enemy
    defenses and your logistics). When net pressure hits a threshold, the
    front line jumps by 25% toward the attacker—otherwise it stays fixed.

Factories (buy from the store with credits):
  1. Vehicle Factory      -> raises vehicle production.
  2. Logistics Hub        -> +20% logistics health (helps all production).
  3. Arms Plant           -> raises arms production.
  4. Aircraft Works       -> raises aircraft production.
  5. Defense Complex      -> raises air defense production.

Run interactively:
  python LF_prototype

Run with a GUI:
  python LF_prototype --gui

Run a quick non-interactive tick burst:
  python LF_prototype --ticks 5
"""

from __future__ import annotations

import argparse
import math
import random
import tkinter as tk
from dataclasses import dataclass, field
from tkinter import messagebox, ttk
from typing import Callable, Dict, List, Optional, Tuple

FRONTLINE_MIN = 0.0
FRONTLINE_MAX = 100.0
FRONTLINE_SEGMENT = 25.0         # front line moves in quarter-map chunks
FRONTLINE_PRESSURE_THRESHOLD = 10.0
FRONTLINE_PRESSURE_DECAY = 0.5   # passive decay of pressure progress each tick
FRONTLINE_OPPOSING_BLEED = 0.35  # how much opposing pressure erodes progress
MISSILE_LOGI_PENALTY_PER = 2.5
MISSILE_LOGI_PENALTY_CAP = 50.0

BASE_CREDITS = 120
INCOME_PER_TICK = 25.0
SUPPLY_ZONE_BONUS = 50
UNIT_BUILD_RATE = 0.12            # how many units per production point per tick
AIR_UNIT_BUILD_RATE = 0.06        # aircraft build slower but hit harder
BUILD_QUEUE_MAX = 9
COMBAT_SCALE = 0.04               # higher = deadlier exchanges per tick
SORTIE_DURATION = 3               # ticks a sortie aircraft are away

# Building system
BUILD_TIMES = {
    1: 2,
    2: 3,
    3: 2,
    4: 3,
    5: 2,
    6: 2,
    7: 1,
    8: 1,
    13: 3,  # Workshop
}


def clamp(value: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, value))


@dataclass
class Factory:
    key: int
    name: str
    cost: int
    description: str
    apply_effect: Callable[["Player"], None]

    def apply(self, player: "Player") -> None:
        self.apply_effect(player)


@dataclass
class Sortie:
    owner: str
    target_attr: str
    committed: float
    remaining: int


@dataclass
class BuildOrder:
    factory: Factory
    remaining: int


@dataclass
class Player:
    name: str
    logistics_health: float = 100.0
    vehicle_prod: float = 25.0
    arms_prod: float = 25.0
    aircraft_prod: float = 25.0
    defense_prod: float = 25.0
    tank_bonus: float = 0.0
    credits: int = BASE_CREDITS
    purchases: Dict[int, int] = field(default_factory=dict)
    supply_zones: int = 0
    workshops: int = 0
    workshops: int = 0
    missile_unlocked: bool = False
    missile_launchers: float = 0.0
    helicopters: float = 0.0
    helipads: int = 0
    armored_synergy_bonus: bool = False
    logistics_penalty: float = 0.0
    # Unit pools
    arms: float = 0.0
    vehicles: float = 0.0  # IFVs
    tanks: float = 0.0
    aircraft: float = 0.0
    def_arms: float = 0.0
    def_vehicle: float = 0.0
    def_air: float = 0.0
    build_queue: List[BuildOrder] = field(default_factory=list)

    def __post_init__(self) -> None:
        for key in range(1, 14):
            self.purchases.setdefault(key, 0)

    @property
    def logistics_factor(self) -> float:
        """
        Dampened effect: 60% baseline + 40% scaled by logistics health.
        """
        effective_logi = max(1.0, self.logistics_health - max(0.0, self.logistics_penalty))
        return 0.6 + 0.4 * (effective_logi / 100.0)

    @property
    def production_components(self) -> Dict[str, float]:
        return {
            "vehicles": self.vehicle_prod,
            "arms": self.arms_prod,
            "aircraft": self.aircraft_prod,
            "air_defense": self.defense_prod,
        }

    @property
    def total_production(self) -> float:
        subtotal = sum(self.production_components.values())
        return round(subtotal * self.logistics_factor, 2)

    def income_this_tick(self) -> int:
        earned = INCOME_PER_TICK * (self.logistics_health / 100.0)
        return max(5, int(round(earned)))

    def earn_income(self) -> None:
        self.credits += self.income_this_tick()

    def apply_factory(self, factory: Factory) -> None:
        factory.apply(self)
        self.purchases[factory.key] += 1

    def produce_units(self) -> None:
        """
        Convert production into unit stocks each tick.
        """
        factor = self.logistics_factor
        self.vehicles += self.vehicle_prod * UNIT_BUILD_RATE * factor
        self.arms += self.arms_prod * UNIT_BUILD_RATE * factor
        self.aircraft += self.aircraft_prod * AIR_UNIT_BUILD_RATE * factor
        self.def_air += self.defense_prod * UNIT_BUILD_RATE * factor * 0.4
        self.def_vehicle += self.defense_prod * UNIT_BUILD_RATE * factor * 0.35
        self.def_arms += self.defense_prod * UNIT_BUILD_RATE * factor * 0.25
        # Tanks scale with logistics and the heavier end of production (vehicles + arms)
        tank_input = ((self.vehicle_prod + self.arms_prod) / 2.0) + self.tank_bonus
        self.tanks += tank_input * UNIT_BUILD_RATE * factor * 0.35

    def apply_losses(self, losses: Dict[str, float]) -> None:
        for key, dmg in losses.items():
            if not hasattr(self, key):
                continue
            setattr(self, key, max(0.0, getattr(self, key) - dmg))

    def build_capacity(self) -> int:
        """
        Building slots scale with base capacity plus workshops.
        """
        return clamp(2 + self.workshops, 1, 9)

    def queue_build(self, factory: Factory) -> None:
        if len(self.build_queue) >= BUILD_QUEUE_MAX:
            raise ValueError(f"{self.name} purchase queue full (max {BUILD_QUEUE_MAX}).")
        build_time = BUILD_TIMES.get(factory.key, 2)
        if len(self.build_queue) >= 9:
            raise ValueError(f"{self.name} purchase queue full (max 9).")
        self.build_queue.append(BuildOrder(factory, build_time))


@dataclass
class GameState:
    player1: Player
    player2: Player
    frontline: float = 50.0  # distance from player1 position (0..100)
    history: List[str] = field(default_factory=list)
    ticks_elapsed: int = 0
    winner: Optional[str] = None
    sorties: List[Sortie] = field(default_factory=list)
    pressure_toward_p2: float = 0.0  # P1 pushing toward P2
    pressure_toward_p1: float = 0.0  # P2 pushing toward P1

    def record(self, message: str) -> None:
        self.history.append(message)
        if len(self.history) > 40:
            self.history = self.history[-40:]

    @property
    def frontline_ratio(self) -> float:
        """
        Returns the ratio (frontline - p1) / (p2 - p1) as a percentage.
        """
        return round((self.frontline - FRONTLINE_MIN) / (FRONTLINE_MAX - FRONTLINE_MIN) * 100.0, 2)


