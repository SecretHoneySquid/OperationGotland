#!/usr/bin/env python3
"""
Two-player production tug-of-war prototype.

You control both sides. Each player starts with 100 logistics health and a
balanced production mix that rolls up into a single production rate. Logistics
is a multiplier on every production type.

Front line logic:
  * Player 1 positioned at 0, Player 2 at 100.
  * Front line starts at 50 and is shown as the percentage
    (frontline - p1) / (p2 - p1).
  * If Player 1 production > Player 2, the front line shifts toward Player 2.
    If Player 2 leads, it shifts back toward Player 1.

Factories (buy from the store with credits):
  1. Vehicle Factory      -> raises vehicle production.
  2. Logistics Hub        -> +20% logistics health (helps all production).
  3. Arms Plant           -> raises arms production.
  4. Aircraft Works       -> raises aircraft production.
  5. Defense Complex      -> raises air defense production.
  6. Supply Zone          -> periodic credit bonus.
  7. Artillery Battery    -> reloads shells to damage enemy logistics.

Run interactively:
  python LF_prototype

Run a quick non-interactive tick burst:
  python LF_prototype --ticks 5
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass, field
from typing import Callable, Dict, List, Optional, Tuple

FRONTLINE_MIN = 0.0
FRONTLINE_MAX = 100.0
FRONTLINE_SHIFT_DIVISOR = 20.0   # higher = slower movement
FRONTLINE_SHIFT_CLAMP = 6.0      # max movement per tick

BASE_CREDITS = 120
INCOME_PER_TICK = 25.0
SUPPLY_ZONE_BONUS = 50
ARTILLERY_BATTERY_COST = 90
ARTILLERY_DAMAGE = 12.5
ARTILLERY_SHELL_CAP = 15
LOGISTICS_MIN = 10.0
LOGISTICS_MAX = 250.0


def clamp(value: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, value))


def apply_artillery_battery(player: "Player") -> None:
    """
    Adds a new artillery battery and fills shells to the new capacity.
    """
    player.artillery_batteries += 1
    player.artillery_shells = player.artillery_capacity


@dataclass
class Factory:
    key: int
    name: str
    cost: int
    description: str
    apply_effect: Callable[["Player"], None]

    def apply(self, player: "Player") -> None:
        self.apply_effect(player)


@dataclass
class Player:
    name: str
    logistics_health: float = 100.0
    vehicle_prod: float = 25.0
    arms_prod: float = 25.0
    aircraft_prod: float = 25.0
    defense_prod: float = 25.0
    credits: int = BASE_CREDITS
    purchases: Dict[int, int] = field(default_factory=dict)
    supply_zones: int = 0
    artillery_batteries: int = 0
    artillery_shells: int = 0

    def __post_init__(self) -> None:
        for key in range(1, 8):
            self.purchases.setdefault(key, 0)

    @property
    def production_components(self) -> Dict[str, float]:
        return {
            "vehicles": self.vehicle_prod,
            "arms": self.arms_prod,
            "aircraft": self.aircraft_prod,
            "air_defense": self.defense_prod,
        }

    @property
    def total_production(self) -> float:
        subtotal = sum(self.production_components.values())
        return round(subtotal * (self.logistics_health / 100.0), 2)

    def income_this_tick(self) -> int:
        earned = INCOME_PER_TICK * (self.logistics_health / 100.0)
        return max(5, int(round(earned)))

    def earn_income(self) -> None:
        self.credits += self.income_this_tick()

    @property
    def artillery_capacity(self) -> int:
        return self.artillery_batteries * ARTILLERY_SHELL_CAP

    def reload_artillery(self) -> int:
        if self.artillery_batteries <= 0:
            return 0
        capacity = self.artillery_capacity
        if capacity <= self.artillery_shells:
            return 0
        available_space = capacity - self.artillery_shells
        loaded = min(self.artillery_batteries, available_space)
        self.artillery_shells += loaded
        return loaded

    def apply_factory(self, factory: Factory) -> None:
        factory.apply(self)
        self.purchases[factory.key] += 1


@dataclass
class GameState:
    player1: Player
    player2: Player
    frontline: float = 50.0  # distance from player1 position (0..100)
    history: List[str] = field(default_factory=list)
    ticks_elapsed: int = 0

    def record(self, message: str) -> None:
        self.history.append(message)
        if len(self.history) > 40:
            self.history = self.history[-40:]

    @property
    def frontline_ratio(self) -> float:
        """
        Returns the ratio (frontline - p1) / (p2 - p1) as a percentage.
        """
        return round((self.frontline - FRONTLINE_MIN) / (FRONTLINE_MAX - FRONTLINE_MIN) * 100.0, 2)


def make_factories() -> Dict[int, Factory]:
    return {
        1: Factory(
            key=1,
            name="Vehicle Factory",
            cost=60,
            description="Boosts vehicle production by +15.",
            apply_effect=lambda p: setattr(p, "vehicle_prod", p.vehicle_prod + 15),
        ),
        2: Factory(
            key=2,
            name="Logistics Hub",
            cost=70,
            description="Improves logistics health by +20% (helps every production type).",
            apply_effect=lambda p: setattr(
                p, "logistics_health", clamp(p.logistics_health * 1.2, LOGISTICS_MIN, LOGISTICS_MAX)
            ),
        ),
        3: Factory(
            key=3,
            name="Arms Plant",
            cost=65,
            description="Raises arms production by +12.",
            apply_effect=lambda p: setattr(p, "arms_prod", p.arms_prod + 12),
        ),
        4: Factory(
            key=4,
            name="Aircraft Works",
            cost=80,
            description="Raises aircraft production by +10.",
            apply_effect=lambda p: setattr(p, "aircraft_prod", p.aircraft_prod + 10),
        ),
        5: Factory(
            key=5,
            name="Defense Complex",
            cost=75,
            description="Raises air defense production by +10.",
            apply_effect=lambda p: setattr(p, "defense_prod", p.defense_prod + 10),
        ),
        6: Factory(
            key=6,
            name="Supply Zone",
            cost=85,
            description=f"Generates +{SUPPLY_ZONE_BONUS} credits every 5th tick.",
            apply_effect=lambda p: setattr(p, "supply_zones", p.supply_zones + 1),
        ),
        7: Factory(
            key=7,
            name="Artillery Battery",
            cost=ARTILLERY_BATTERY_COST,
            description=(
                f"Adds an artillery battery that reloads 1 shell per tick "
                f"(max {ARTILLERY_SHELL_CAP} shells each); shells deal {ARTILLERY_DAMAGE} logistics damage."
            ),
            apply_effect=lambda p: apply_artillery_battery(p),
        ),
    }


def describe_player(player: Player) -> str:
    parts = [
        f"{player.name} :: Credits {player.credits} | Logistics {player.logistics_health:.1f}",
        f"  Vehicles {player.vehicle_prod:.1f} | Arms {player.arms_prod:.1f} | "
        f"Aircraft {player.aircraft_prod:.1f} | Air Defense {player.defense_prod:.1f}",
        f"  Total Production (all types x logistics): {player.total_production:.2f}",
        f"  Artillery: {player.artillery_batteries} batteries | Shells {player.artillery_shells}/{player.artillery_capacity}",
        "  Purchases: " + ", ".join(f"F{key} x{count}" for key, count in sorted(player.purchases.items())),
    ]
    return "\n".join(parts)


def describe_store(factories: Dict[int, Factory]) -> str:
    lines = ["Store:", " key | cost | name", "-" * 30]
    for key, factory in sorted(factories.items()):
        lines.append(f"  {key:^3} | {factory.cost:^4} | {factory.name}")
        lines.append(f"      -> {factory.description}")
    return "\n".join(lines)


def advance_tick(state: GameState) -> Tuple[float, float, Optional[str]]:
    state.ticks_elapsed += 1
    p1_prod = state.player1.total_production
    p2_prod = state.player2.total_production
    advantage = p1_prod - p2_prod

    if advantage == 0:
        delta = 0.0
    else:
        delta = clamp(advantage / FRONTLINE_SHIFT_DIVISOR, -FRONTLINE_SHIFT_CLAMP, FRONTLINE_SHIFT_CLAMP)

    state.frontline = clamp(state.frontline + delta, FRONTLINE_MIN, FRONTLINE_MAX)

    # If the frontline hits either bound, the game ends immediately so callers can stop ticking.
    winner: Optional[str] = None
    if state.frontline <= FRONTLINE_MIN:
        winner = state.player2.name
    elif state.frontline >= FRONTLINE_MAX:
        winner = state.player1.name

    if winner:
        state.record(
            f"{winner} wins on tick {state.ticks_elapsed}! Front line reached {state.frontline_ratio:.2f}% "
            f"(P1 prod {p1_prod:.2f} vs P2 {p2_prod:.2f})."
        )
        return p1_prod, p2_prod, winner

    state.player1.earn_income()
    state.player2.earn_income()

    for player in (state.player1, state.player2):
        loaded = player.reload_artillery()
        if loaded:
            note = f"{player.name} reloaded {loaded} artillery shells ({player.artillery_shells}/{player.artillery_capacity})."
            if player.artillery_shells == player.artillery_capacity:
                note += " Artillery is fully stocked."
            state.record(note)

    if state.ticks_elapsed % 5 == 0:
        for player in (state.player1, state.player2):
            if player.supply_zones > 0:
                bonus = player.supply_zones * SUPPLY_ZONE_BONUS
                player.credits += bonus
                state.record(f"{player.name} gained {bonus} bonus credits from supply zones on tick {state.ticks_elapsed}.")

    state.record(
        f"Tick: P1 prod {p1_prod:.2f} vs P2 {p2_prod:.2f} -> frontline shift {delta:+.2f} to {state.frontline_ratio:.2f}%"
    )
    return p1_prod, p2_prod, None


def fire_artillery(state: GameState, attacker_key: str, shells: int) -> str:
    attacker = state.player1 if attacker_key.lower() in ("1", "p1", "player1") else state.player2
    defender = state.player2 if attacker is state.player1 else state.player1

    if attacker.artillery_batteries <= 0:
        raise ValueError(f"{attacker.name} has no artillery batteries to fire.")
    if shells <= 0:
        raise ValueError("Shells fired must be at least 1.")

    available_shells = attacker.artillery_shells
    if available_shells <= 0:
        raise ValueError(f"{attacker.name} has no loaded artillery shells.")

    shells_used = min(shells, available_shells)
    attacker.artillery_shells -= shells_used
    damage = round(shells_used * ARTILLERY_DAMAGE, 2)
    before = defender.logistics_health
    defender.logistics_health = clamp(defender.logistics_health - damage, LOGISTICS_MIN, LOGISTICS_MAX)
    actual_damage = round(before - defender.logistics_health, 2)

    state.record(
        f"{attacker.name} fired {shells_used} artillery shells at {defender.name}, dealing {actual_damage:.1f} logistics damage."
    )

    return (
        f"{attacker.name} fired {shells_used} shell(s) at {defender.name}, "
        f"dealing {actual_damage:.1f} logistics damage. {defender.name} logistics now "
        f"{defender.logistics_health:.1f}. Shells remaining: {attacker.artillery_shells}/{attacker.artillery_capacity}"
    )


def buy_factory(
    state: GameState, player_key: str, factory_id: int, factories: Dict[int, Factory], quantity: int = 1
) -> str:
    player = state.player1 if player_key.lower() in ("1", "p1", "player1") else state.player2
    if factory_id not in factories:
        raise ValueError(f"Factory {factory_id} is not in the store.")
    if quantity <= 0:
        raise ValueError("Quantity must be at least 1.")

    factory = factories[factory_id]
    total_cost = factory.cost * quantity
    if player.credits < total_cost:
        raise ValueError(
            f"{player.name} lacks credits ({player.credits}) for {quantity}x {factory.name} (cost {total_cost})."
        )

    player.credits -= total_cost
    for _ in range(quantity):
        player.apply_factory(factory)
    plural = "factory" if quantity == 1 else "factories"
    state.record(f"{player.name} bought {quantity} {factory.name} {plural} for {total_cost} credits.")
    return f"{player.name} bought {quantity}x {factory.name}. Remaining credits: {player.credits}"


def show_status(state: GameState) -> str:
    lines = [
        f"Front line at {state.frontline:.2f} (ratio {state.frontline_ratio:.2f}% between Player 1 @0 and Player 2 @100)",
        describe_player(state.player1),
        describe_player(state.player2),
    ]
    return "\n".join(lines)


def print_help() -> str:
    return (
        "Commands:\n"
        "  status                  -> show both players and the front line\n"
        "  store                   -> list factories and effects\n"
        "  buy <p1|p2> <id> [n|max]-> purchase factories (single, n copies, or max affordable)\n"
        "  fire <p1|p2> <n|all>    -> spend shells from artillery batteries to damage enemy logistics\n"
        "  tick [n]                -> advance the simulation by n ticks (default 1)\n"
        "  log                     -> show recent events\n"
        "  help                    -> show this message\n"
        "  quit                    -> exit\n"
    )


def interactive_loop(state: GameState, factories: Dict[int, Factory]) -> None:
    print("Logistics & Production tug-of-war. Type 'help' for commands.")
    print(show_status(state))

    while True:
        try:
            raw = input("\ncommand> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nExiting.")
            break

        if not raw:
            continue
        parts = raw.split()
        cmd = parts[0].lower()

        try:
            if cmd in ("quit", "exit", "q"):
                print("Goodbye.")
                break
            if cmd == "help":
                print(print_help())
            elif cmd == "status":
                print(show_status(state))
            elif cmd == "store":
                print(describe_store(factories))
            elif cmd == "log":
                print("\n".join(state.history[-10:]) or "No history yet.")
            elif cmd == "buy":
                if len(parts) < 3:
                    print("Usage: buy <p1|p2> <factory_id> [n|max]")
                    continue
                quantity = 1
                if len(parts) >= 4:
                    if parts[3].lower() == "max":
                        factory_id = int(parts[2])
                        if factory_id not in factories:
                            print(f"Factory {factory_id} is not in the store.")
                            continue
                        factory = factories[factory_id]
                        player = state.player1 if parts[1].lower() in ("1", "p1", "player1") else state.player2
                        quantity = max(1, player.credits // factory.cost)
                    else:
                        quantity = int(parts[3])
                message = buy_factory(state, parts[1], int(parts[2]), factories, quantity)
                print(message)
            elif cmd in ("fire", "artillery"):
                if len(parts) < 3:
                    print("Usage: fire <p1|p2> <n|all>")
                    continue
                attacker = state.player1 if parts[1].lower() in ("1", "p1", "player1") else state.player2
                shells_arg = parts[2].lower()
                if shells_arg in ("all", "max"):
                    shells = attacker.artillery_shells
                else:
                    shells = int(shells_arg)
                message = fire_artillery(state, parts[1], shells)
                print(message)
            elif cmd == "tick":
                ticks = int(parts[1]) if len(parts) > 1 else 1
                winner: Optional[str] = None
                for _ in range(max(1, ticks)):
                    _, _, winner = advance_tick(state)
                    if winner:
                        print(f"{winner} wins! Game over after {state.ticks_elapsed} ticks.")
                        print(show_status(state))
                        break
                if winner:
                    break
                print(show_status(state))
            else:
                print("Unknown command. Type 'help' for options.")
        except ValueError as exc:
            print(f"Error: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Two-player logistics & production tug-of-war.")
    parser.add_argument(
        "--ticks",
        type=int,
        default=0,
        help="If set, run this many ticks non-interactively then print status and exit.",
    )
    args = parser.parse_args()

    factories = make_factories()
    state = GameState(player1=Player("Player 1"), player2=Player("Player 2"))

    if args.ticks > 0:
        winner: Optional[str] = None
        for _ in range(max(1, args.ticks)):
            _, _, winner = advance_tick(state)
            if winner:
                break
        print(show_status(state))
        if winner:
            print(f"\n{winner} wins after {state.ticks_elapsed} ticks!")
        print("\nRecent events:")
        for line in state.history[-10:]:
            print(" -", line)
    else:
        interactive_loop(state, factories)


if __name__ == "__main__":
    main()
