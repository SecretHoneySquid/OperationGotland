#!/usr/bin/env python3
"""
Two-player production tug-of-war prototype.

You control both sides. Each player starts with 100 logistics health and a
balanced production mix that rolls up into a single production rate. Logistics
is a multiplier on every production type.

Front line logic:
  * Player 1 positioned at 0, Player 2 at 100.
  * Front line starts at 50 and is shown as the percentage
    (frontline - p1) / (p2 - p1).
  * If Player 1 production > Player 2, the front line shifts toward Player 2.
    If Player 2 leads, it shifts back toward Player 1.

Factories (buy from the store with credits):
  1. Vehicle Factory      -> raises vehicle production.
  2. Logistics Hub        -> +20% logistics health (helps all production).
  3. Arms Plant           -> raises arms production.
  4. Aircraft Works       -> raises aircraft production.
  5. Defense Complex      -> raises air defense production.

Run interactively:
  python LF_prototype

Run a quick non-interactive tick burst:
  python LF_prototype --ticks 5
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass, field
from typing import Callable, Dict, List, Tuple
from typing import Optional

FRONTLINE_MIN = 0.0
FRONTLINE_MAX = 100.0
FRONTLINE_SHIFT_DIVISOR = 20.0   # higher = slower movement
FRONTLINE_SHIFT_CLAMP = 6.0      # max movement per tick
FRONTLINE_UNIT_WEIGHT = 0.25     # how much unit advantage moves the line (relative to production)

BASE_CREDITS = 120
INCOME_PER_TICK = 25.0
SUPPLY_ZONE_BONUS = 50
UNIT_BUILD_RATE = 0.12            # how many units per production point per tick
COMBAT_SCALE = 0.02               # higher = deadlier exchanges per tick

# Building system
BUILD_TIMES = {
    1: 2,
    2: 3,
    3: 2,
    4: 3,
    5: 2,
    6: 2,
    7: 1,
    8: 1,
}


def clamp(value: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, value))


@dataclass
class Factory:
    key: int
    name: str
    cost: int
    description: str
    apply_effect: Callable[["Player"], None]

    def apply(self, player: "Player") -> None:
        self.apply_effect(player)


@dataclass
class BuildOrder:
    factory: Factory
    remaining: int


@dataclass
class Player:
    name: str
    logistics_health: float = 100.0
    vehicle_prod: float = 25.0
    arms_prod: float = 25.0
    aircraft_prod: float = 25.0
    defense_prod: float = 25.0
    credits: int = BASE_CREDITS
    purchases: Dict[int, int] = field(default_factory=dict)
    supply_zones: int = 0
    # Unit pools
    arms: float = 0.0
    vehicles: float = 0.0  # IFVs
    tanks: float = 0.0
    aircraft: float = 0.0
    def_arms: float = 0.0
    def_vehicle: float = 0.0
    def_air: float = 0.0
    build_queue: List[BuildOrder] = field(default_factory=list)

    def __post_init__(self) -> None:
        for key in range(1, 9):
            self.purchases.setdefault(key, 0)

    @property
    def logistics_factor(self) -> float:
        """
        Dampened effect: 60% baseline + 40% scaled by logistics health.
        """
        return 0.6 + 0.4 * (self.logistics_health / 100.0)

    @property
    def production_components(self) -> Dict[str, float]:
        return {
            "vehicles": self.vehicle_prod,
            "arms": self.arms_prod,
            "aircraft": self.aircraft_prod,
            "air_defense": self.defense_prod,
        }

    @property
    def total_production(self) -> float:
        subtotal = sum(self.production_components.values())
        return round(subtotal * self.logistics_factor, 2)

    def income_this_tick(self) -> int:
        earned = INCOME_PER_TICK * (self.logistics_health / 100.0)
        return max(5, int(round(earned)))

    def earn_income(self) -> None:
        self.credits += self.income_this_tick()

    def apply_factory(self, factory: Factory) -> None:
        factory.apply(self)
        self.purchases[factory.key] += 1

    def produce_units(self) -> None:
        """
        Convert production into unit stocks each tick.
        """
        factor = self.logistics_factor
        self.vehicles += self.vehicle_prod * UNIT_BUILD_RATE * factor
        self.arms += self.arms_prod * UNIT_BUILD_RATE * factor
        self.aircraft += self.aircraft_prod * UNIT_BUILD_RATE * factor
        self.def_air += self.defense_prod * UNIT_BUILD_RATE * factor * 0.4
        self.def_vehicle += self.defense_prod * UNIT_BUILD_RATE * factor * 0.35
        self.def_arms += self.defense_prod * UNIT_BUILD_RATE * factor * 0.25
        # Tanks scale with logistics and the heavier end of production (vehicles + arms)
        self.tanks += ((self.vehicle_prod + self.arms_prod) / 2.0) * UNIT_BUILD_RATE * factor * 0.5

    def apply_losses(self, losses: Dict[str, float]) -> None:
        for key, dmg in losses.items():
            if not hasattr(self, key):
                continue
            setattr(self, key, max(0.0, getattr(self, key) - dmg))

    def build_capacity(self) -> int:
        """
        Building slots scale with logistics. Minimum 1, max 5.
        """
        return clamp(int(self.logistics_health // 30) + 1, 1, 5)

    def queue_build(self, factory: Factory) -> None:
        if len(self.build_queue) >= self.build_capacity():
            raise ValueError(f"{self.name} build queue full (cap {self.build_capacity()}).")
        build_time = BUILD_TIMES.get(factory.key, 2)
        self.build_queue.append(BuildOrder(factory, build_time))


@dataclass
class GameState:
    player1: Player
    player2: Player
    frontline: float = 50.0  # distance from player1 position (0..100)
    history: List[str] = field(default_factory=list)
    ticks_elapsed: int = 0
    winner: Optional[str] = None

    def record(self, message: str) -> None:
        self.history.append(message)
        if len(self.history) > 40:
            self.history = self.history[-40:]

    @property
    def frontline_ratio(self) -> float:
        """
        Returns the ratio (frontline - p1) / (p2 - p1) as a percentage.
        """
        return round((self.frontline - FRONTLINE_MIN) / (FRONTLINE_MAX - FRONTLINE_MIN) * 100.0, 2)


def make_factories() -> Dict[int, Factory]:
    return {
        1: Factory(
            key=1,
            name="Vehicle Factory",
            cost=60,
            description="Boosts vehicle production by +15.",
            apply_effect=lambda p: setattr(p, "vehicle_prod", p.vehicle_prod + 15),
        ),
        2: Factory(
            key=2,
            name="Logistics Hub",
            cost=70,
            description="Improves logistics health by +20% (helps every production type).",
            apply_effect=lambda p: setattr(p, "logistics_health", clamp(p.logistics_health * 1.2, 10.0, 250.0)),
        ),
        3: Factory(
            key=3,
            name="Arms Plant",
            cost=65,
            description="Raises arms production by +12.",
            apply_effect=lambda p: setattr(p, "arms_prod", p.arms_prod + 12),
        ),
        4: Factory(
            key=4,
            name="Aircraft Works",
            cost=80,
            description="Raises aircraft production by +10.",
            apply_effect=lambda p: setattr(p, "aircraft_prod", p.aircraft_prod + 10),
        ),
        5: Factory(
            key=5,
            name="Defense Complex",
            cost=75,
            description="Raises air defense production by +10.",
            apply_effect=lambda p: setattr(p, "defense_prod", p.defense_prod + 10),
        ),
        6: Factory(
            key=6,
            name="Supply Zone",
            cost=85,
            description=f"Generates +{SUPPLY_ZONE_BONUS} credits every 5th tick.",
            apply_effect=lambda p: setattr(p, "supply_zones", p.supply_zones + 1),
        ),
        7: Factory(
            key=7,
            name="Infantry Defense Network",
            cost=70,
            description="Deploys infantry defenses (immediate +30 def_arms units).",
            apply_effect=lambda p: setattr(p, "def_arms", p.def_arms + 30),
        ),
        8: Factory(
            key=8,
            name="Vehicle Defense Network",
            cost=80,
            description="Deploys vehicle defenses (immediate +30 def_vehicle units).",
            apply_effect=lambda p: setattr(p, "def_vehicle", p.def_vehicle + 30),
        ),
    }


def describe_player(player: Player) -> str:
    parts = [
        f"{player.name} :: Credits {player.credits} | Logistics {player.logistics_health:.1f}",
        f"  Vehicles {player.vehicle_prod:.1f} | Arms {player.arms_prod:.1f} | "
        f"Aircraft {player.aircraft_prod:.1f} | Air Defense {player.defense_prod:.1f}",
        f"  Total Production (all types x logistics): {player.total_production:.2f}",
        "  Units: "
        f"Arms {player.arms:.1f}, IFVs {player.vehicles:.1f}, Tanks {player.tanks:.1f}, "
        f"Aircraft {player.aircraft:.1f}, Def(arms/veh/air) "
        f"{player.def_arms:.1f}/{player.def_vehicle:.1f}/{player.def_air:.1f}",
        f"  Build Queue (cap {player.build_capacity()}): "
        + (", ".join(f"{bo.factory.name} ({bo.remaining}t)" for bo in player.build_queue) or "empty"),
        "  Purchases: " + ", ".join(f"F{key} x{count}" for key, count in sorted(player.purchases.items())),
    ]
    return "\n".join(parts)


def describe_store(factories: Dict[int, Factory]) -> str:
    lines = ["Store:", " key | cost | name", "-" * 30]
    for key, factory in sorted(factories.items()):
        lines.append(f"  {key:^3} | {factory.cost:^4} | {factory.name}")
        lines.append(f"      -> {factory.description}")
    return "\n".join(lines)


def advance_tick(state: GameState) -> Tuple[float, float]:
    if state.winner:
        return state.player1.total_production, state.player2.total_production

    state.ticks_elapsed += 1
    p1_prod = state.player1.total_production
    p2_prod = state.player2.total_production
    advantage = p1_prod - p2_prod

    if advantage == 0:
        delta = 0.0
    else:
        delta = clamp(advantage / FRONTLINE_SHIFT_DIVISOR, -FRONTLINE_SHIFT_CLAMP, FRONTLINE_SHIFT_CLAMP)

    # Unit-driven pressure (not sole factor)
    unit_adv = unit_pressure_advantage(state.player1, state.player2)
    delta += unit_adv * FRONTLINE_UNIT_WEIGHT

    state.frontline = clamp(state.frontline + delta, FRONTLINE_MIN, FRONTLINE_MAX)
    check_victory(state)
    if state.winner:
        state.record(
            f"Tick {state.ticks_elapsed}: {state.winner} reached the front-line limit ({state.frontline_ratio:.2f}%)."
        )
        return p1_prod, p2_prod

    state.player1.earn_income()
    state.player2.earn_income()
    process_builds(state)
    state.player1.produce_units()
    state.player2.produce_units()

    resolve_combat(state)

    if state.ticks_elapsed % 5 == 0:
        for player in (state.player1, state.player2):
            if player.supply_zones > 0:
                bonus = player.supply_zones * SUPPLY_ZONE_BONUS
                player.credits += bonus
                state.record(f"{player.name} gained {bonus} bonus credits from supply zones on tick {state.ticks_elapsed}.")

    state.record(
        f"Tick: P1 prod {p1_prod:.2f} vs P2 {p2_prod:.2f} -> frontline shift {delta:+.2f} to {state.frontline_ratio:.2f}%"
    )
    return p1_prod, p2_prod


def process_builds(state: GameState) -> None:
    """
    Progress build queues and deliver completed factories.
    """
    for player in (state.player1, state.player2):
        if not player.build_queue:
            continue
        still_building: List[BuildOrder] = []
        for order in player.build_queue:
            order.remaining -= 1
            if order.remaining <= 0:
                player.apply_factory(order.factory)
                state.record(f"{player.name} completed {order.factory.name}.")
            else:
                still_building.append(order)
        player.build_queue = still_building


def resolve_combat(state: GameState) -> None:
    """
    Exchange casualties between players based on unit matchup rules.
    """
    if state.winner:
        return

    p1_losses = casualties_from(state.player2, state.player1)
    p2_losses = casualties_from(state.player1, state.player2)

    if any(val > 0 for val in p1_losses.values()):
        state.player1.apply_losses(p1_losses)
    if any(val > 0 for val in p2_losses.values()):
        state.player2.apply_losses(p2_losses)

    if any(val > 0 for val in p1_losses.values()) or any(val > 0 for val in p2_losses.values()):
        state.record(
            f"Combat: P1 lost {format_losses(p1_losses)} | P2 lost {format_losses(p2_losses)}"
        )


def casualties_from(attacker: Player, defender: Player) -> Dict[str, float]:
    """
    Compute losses inflicted by attacker on defender.
    """
    # Effectiveness coefficients attacker_type -> defender_type
    eff: Dict[str, Dict[str, float]] = {
        "arms": {"vehicles": 0.6, "aircraft": 0.1},
        "vehicles": {"arms": 0.8, "vehicles": 0.3},
        "tanks": {"vehicles": 0.8, "tanks": 0.5, "def_vehicle": 0.6, "def_arms": 0.4},
        "aircraft": {
            "tanks": 0.9,
            "vehicles": 1.35,  # buff vs IFVs/vehicles
            "aircraft": 0.6,
            "def_air": 0.4,
            "def_vehicle": 0.5,  # more threat to vehicle defenses
            "def_arms": 0.35,
            "arms": 0.25,
        },
        "def_arms": {"arms": 0.7},
        "def_vehicle": {"vehicles": 0.7},
        "def_air": {"aircraft": 1.0},
    }

    attacker_counts = {
        "arms": attacker.arms,
        "vehicles": attacker.vehicles,
        "tanks": attacker.tanks,
        "aircraft": attacker.aircraft,
        "def_arms": attacker.def_arms,
        "def_vehicle": attacker.def_vehicle,
        "def_air": attacker.def_air,
    }
    losses: Dict[str, float] = {k: 0.0 for k in attacker_counts.keys()}

    for atk_type, atk_count in attacker_counts.items():
        if atk_count <= 0:
            continue
        for def_type, coeff in eff.get(atk_type, {}).items():
            if hasattr(defender, def_type):
                losses[def_type] += atk_count * coeff * COMBAT_SCALE

    return {k: v for k, v in losses.items() if v > 0}


def format_losses(losses: Dict[str, float]) -> str:
    if not losses:
        return "no losses"
    return ", ".join(f"{k}:{v:.1f}" for k, v in sorted(losses.items()))


def unit_pressure_advantage(p1: Player, p2: Player) -> float:
    """
    Convert unit advantage to a small frontline push component.
    """
    def power(p: Player) -> float:
        return (
            p.arms * 0.8
            + p.vehicles * 1.0
            + p.tanks * 1.3
            + p.aircraft * 1.4
            + p.def_arms * 0.5
            + p.def_vehicle * 0.7
            + p.def_air * 0.7
        )

    advantage = power(p1) - power(p2)
    # Normalize to a small delta
    return clamp(advantage / 50.0, -FRONTLINE_SHIFT_CLAMP / 2, FRONTLINE_SHIFT_CLAMP / 2)


def check_victory(state: GameState) -> None:
    if state.winner:
        return
    if state.frontline <= FRONTLINE_MIN:
        state.winner = state.player2.name
        state.frontline = FRONTLINE_MIN
    elif state.frontline >= FRONTLINE_MAX:
        state.winner = state.player1.name
        state.frontline = FRONTLINE_MAX


def buy_factory(
    state: GameState, player_key: str, factory_id: int, factories: Dict[int, Factory], quantity: int = 1
) -> str:
    player = state.player1 if player_key.lower() in ("1", "p1", "player1") else state.player2
    if factory_id not in factories:
        raise ValueError(f"Factory {factory_id} is not in the store.")
    if quantity <= 0:
        raise ValueError("Quantity must be at least 1.")

    factory = factories[factory_id]
    total_cost = factory.cost * quantity
    if player.credits < total_cost:
        raise ValueError(
            f"{player.name} lacks credits ({player.credits}) for {quantity}x {factory.name} (cost {total_cost})."
        )

    # Queue builds respecting capacity
    for _ in range(quantity):
        player.queue_build(factory)
    player.credits -= total_cost

    plural = "factory" if quantity == 1 else "factories"
    state.record(f"{player.name} queued {quantity} {factory.name} {plural} (build) for {total_cost} credits.")
    return f"{player.name} queued {quantity}x {factory.name}. Remaining credits: {player.credits}"


def show_status(state: GameState) -> str:
    lines = [
        f"Front line at {state.frontline:.2f} (ratio {state.frontline_ratio:.2f}% between Player 1 @0 and Player 2 @100)",
        describe_player(state.player1),
        describe_player(state.player2),
    ]
    if state.winner:
        lines.append(f"🏁 {state.winner} controls the front line. Game over.")
    return "\n".join(lines)


def print_help() -> str:
    return (
        "Commands:\n"
        "  status                  -> show both players and the front line\n"
        "  store                   -> list factories and effects\n"
        "  buy <p1|p2> <id> [n|max]-> queue factory builds (single, n copies, or max affordable)\n"
        "  tick [n]                -> advance the simulation by n ticks (default 1)\n"
        "  log                     -> show recent events\n"
        "  help                    -> show this message\n"
        "  quit                    -> exit\n"
    )


def interactive_loop(state: GameState, factories: Dict[int, Factory]) -> None:
    print("Logistics & Production tug-of-war. Type 'help' for commands.")
    print(show_status(state))

    while True:
        try:
            raw = input("\ncommand> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nExiting.")
            break

        if not raw:
            continue
        parts = raw.split()
        cmd = parts[0].lower()

        try:
            if cmd in ("quit", "exit", "q"):
                print("Goodbye.")
                break
            if cmd == "help":
                print(print_help())
            elif cmd == "status":
                print(show_status(state))
            elif cmd == "store":
                print(describe_store(factories))
            elif cmd == "log":
                print("\n".join(state.history[-10:]) or "No history yet.")
            elif cmd == "buy":
                if len(parts) < 3:
                    print("Usage: buy <p1|p2> <factory_id> [n|max]")
                    continue
                if state.winner:
                    print("Game is over. No more purchases.")
                    continue
                quantity = 1
                if len(parts) >= 4:
                    if parts[3].lower() == "max":
                        factory_id = int(parts[2])
                        if factory_id not in factories:
                            print(f"Factory {factory_id} is not in the store.")
                            continue
                        factory = factories[factory_id]
                        player = state.player1 if parts[1].lower() in ("1", "p1", "player1") else state.player2
                        quantity = max(1, player.credits // factory.cost)
                    else:
                        quantity = int(parts[3])
                message = buy_factory(state, parts[1], int(parts[2]), factories, quantity)
                print(message)
            elif cmd == "tick":
                if state.winner:
                    print(f"Game is over. {state.winner} already controls the front line.")
                    continue
                ticks = int(parts[1]) if len(parts) > 1 else 1
                for _ in range(max(1, ticks)):
                    advance_tick(state)
                    if state.winner:
                        break
                print(show_status(state))
            else:
                print("Unknown command. Type 'help' for options.")
        except ValueError as exc:
            print(f"Error: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Two-player logistics & production tug-of-war.")
    parser.add_argument(
        "--ticks",
        type=int,
        default=0,
        help="If set, run this many ticks non-interactively then print status and exit.",
    )
    args = parser.parse_args()

    factories = make_factories()
    state = GameState(player1=Player("Player 1"), player2=Player("Player 2"))

    if args.ticks > 0:
        for _ in range(max(1, args.ticks)):
            advance_tick(state)
            if state.winner:
                break
        print(show_status(state))
        print("\nRecent events:")
        for line in state.history[-10:]:
            print(" -", line)
    else:
        interactive_loop(state, factories)


if __name__ == "__main__":
    main()
