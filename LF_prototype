def describe_player(player: Player) -> str:
    parts = [
        f"{player.name} :: Credits {player.credits} | Logistics {player.logistics_health:.1f}",
        f"  Vehicles {player.vehicle_prod:.1f} | Arms {player.arms_prod:.1f} | "
        f"Aircraft {player.aircraft_prod:.1f} | Defense {player.defense_prod:.1f}",
        f"  Total Production (all types x logistics): {player.total_production:.2f}",
        "  Units: "
        f"Arms {player.arms:.1f}, IFVs {player.vehicles:.1f}, Tanks {player.tanks:.1f}, "
        f"Aircraft {player.aircraft:.1f}, Helicopters {player.helicopters:.1f}, Missiles {player.missile_launchers:.1f}, "
        f"Ground Def (arms/veh) {player.def_arms:.1f}/{player.def_vehicle:.1f}, Air Def {player.def_air:.1f}",
        f"  Build Queue (processing {player.build_capacity()} | queue {len(player.build_queue)}/{BUILD_QUEUE_MAX}): "
        + (", ".join(f"{bo.factory.name} ({bo.remaining}t)" for bo in player.build_queue) or "empty"),
        "  Purchases: " + ", ".join(f"F{key} x{count}" for key, count in sorted(player.purchases.items())),
    ]
    return "\n".join(parts)


def describe_store(factories: Dict[int, Factory]) -> str:
    lines = ["Store:", " key | cost | name", "-" * 30]
    for key, factory in sorted(factories.items()):
        lines.append(f"  {key:^3} | {factory.cost:^4} | {factory.name}")
        lines.append(f"      -> {factory.description}")
    return "\n".join(lines)


def advance_tick(state: GameState) -> Tuple[float, float]:
    if state.winner:
        return state.player1.total_production, state.player2.total_production

    state.ticks_elapsed += 1
    state.player1.logistics_penalty = missile_penalty_value(state.player2, state.frontline)
    state.player2.logistics_penalty = missile_penalty_value(state.player1, state.frontline)
    if state.player1.logistics_penalty > 0 or state.player2.logistics_penalty > 0:
        state.record(
            f"Missile pressure -> P1 -{state.player1.logistics_penalty:.1f} logi, "
            f"P2 -{state.player2.logistics_penalty:.1f} logi."
        )
    p1_prod = state.player1.total_production
    p2_prod = state.player2.total_production

    state.player1.earn_income()
    state.player2.earn_income()
    process_builds(state)
    process_sorties(state)
    if state.ticks_elapsed % 5 == 0:
        for player in (state.player1, state.player2):
            if player.helipads > 0:
                player.helicopters += player.helipads * 1
                state.record(f"{player.name} received {player.helipads} reinforcement helicopters (helipad drip).")
    state.player1.produce_units()
    state.player2.produce_units()

    resolve_combat(state)

    if state.ticks_elapsed % 5 == 0:
        for player in (state.player1, state.player2):
            if player.supply_zones > 0:
                bonus = player.supply_zones * SUPPLY_ZONE_BONUS
                player.credits += bonus
                state.record(f"{player.name} gained {bonus} bonus credits from supply zones on tick {state.ticks_elapsed}.")

    p1_net, p1_components = compute_frontline_pressure(state.player1, state.player2)
    p2_net, p2_components = compute_frontline_pressure(state.player2, state.player1)
    state.record(
        f"Frontline Pressure (P1->P2): {format_pressure_components(p1_components)} | Net {p1_net:+.1f}"
    )
    state.record(
        f"Frontline Pressure (P2->P1): {format_pressure_components(p2_components)} | Net {p2_net:+.1f}"
    )
    apply_frontline_pressure(state, p1_net, p2_net)
    if not state.winner:
        state.record(
            f"Tick {state.ticks_elapsed}: P1 prod {p1_prod:.2f} vs P2 {p2_prod:.2f} | "
            f"Progress P1->{state.player2.name} {state.pressure_toward_p2:.1f}/"
            f"{FRONTLINE_PRESSURE_THRESHOLD}, "
            f"P2->{state.player1.name} {state.pressure_toward_p1:.1f}/{FRONTLINE_PRESSURE_THRESHOLD} | "
            f"Front line {state.frontline_ratio:.2f}%"
        )
    return p1_prod, p2_prod


def process_builds(state: GameState) -> None:
    """
    Progress build queues and deliver completed factories.
    """
    for player in (state.player1, state.player2):
        if not player.build_queue:
            continue
        still_building: List[BuildOrder] = []
        parallel_slots = player.build_capacity()
        to_process = player.build_queue[:parallel_slots]
        deferred = player.build_queue[parallel_slots:]
        for order in to_process:
            order.remaining -= 1
            if order.remaining <= 0:
                player.apply_factory(order.factory)
                state.record(f"{player.name} completed {order.factory.name}.")
            else:
                still_building.append(order)
        player.build_queue = still_building + deferred


def launch_sortie(state: GameState, player_key: str, size_key: str, target_key: str) -> str:
    if state.winner:
        raise ValueError("Game is over.")

    player = state.player1 if player_key.lower() in ("1", "p1", "player1") else state.player2
    size_map = {"small": 0.1, "sm": 0.1, "med": 0.25, "medium": 0.25, "large": 0.5, "lg": 0.5}
    target_map = {
        "vehicles": "vehicle_prod",
        "arms": "arms_prod",
        "air": "aircraft_prod",
        "def": "defense_prod",
        "logi": "logistics_health",
        "logistics": "logistics_health",
    }

    if size_key.lower() not in size_map:
        raise ValueError("Size must be small/med/large.")
    if target_key.lower() not in target_map:
        raise ValueError("Target must be one of: vehicles, arms, air, def, logi.")
    if player.aircraft < 1.0:
        raise ValueError(f"{player.name} has no aircraft to launch.")

    frac = size_map[size_key.lower()]
    committed = max(1.0, round(player.aircraft * frac, 1))
    committed = min(committed, player.aircraft)
    player.aircraft -= committed

    target_attr = target_map[target_key.lower()]
    state.sorties.append(Sortie(owner=player.name, target_attr=target_attr, committed=committed, remaining=SORTIE_DURATION))
    state.record(f"{player.name} launched air sortie ({size_key}, {committed:.1f} aircraft) vs {target_key}.")
    return f"{player.name} launched air sortie with {committed:.1f} aircraft targeting {target_key}."


def process_sorties(state: GameState) -> None:
    if state.winner or not state.sorties:
        return
    remaining: List[Sortie] = []
    for sortie in state.sorties:
        sortie.remaining -= 1
        if sortie.remaining > 0:
            remaining.append(sortie)
            continue

        attacker = state.player1 if sortie.owner == state.player1.name else state.player2
        defender = state.player2 if attacker is state.player1 else state.player1

        attack_strength = sortie.committed
        defense_strength = defender.def_air * 0.8 + defender.aircraft * 0.6 + 5.0
        success = attack_strength / (attack_strength + defense_strength + 1.0)
        damage = success * 12.0

        if sortie.target_attr == "logistics_health":
            defender.logistics_health = clamp(defender.logistics_health - damage * 0.7, 1.0, 250.0)
        else:
            cur = getattr(defender, sortie.target_attr)
            setattr(defender, sortie.target_attr, max(0.0, cur - damage))

        loss_rate = (1.0 - success) * 0.6 + defender.def_air * 0.005
        losses = min(sortie.committed, sortie.committed * loss_rate)
        survivors = max(0.0, sortie.committed - losses)
        attacker.aircraft += survivors

        state.record(
            f"Sortie resolved: {attacker.name} hit {defender.name}'s {sortie.target_attr} for {damage:.1f}, "
            f"lost {losses:.1f} aircraft (returned {survivors:.1f})."
        )
    state.sorties = remaining


def resolve_combat(state: GameState) -> None:
    """
    Exchange casualties between players based on unit matchup rules.
    """
    if state.winner:
        return

    p1_losses = casualties_from(state.player2, state.player1)
    p2_losses = casualties_from(state.player1, state.player2)

    if any(val > 0 for val in p1_losses.values()):
        state.player1.apply_losses(p1_losses)
    if any(val > 0 for val in p2_losses.values()):
        state.player2.apply_losses(p2_losses)

    if any(val > 0 for val in p1_losses.values()) or any(val > 0 for val in p2_losses.values()):
        state.record(
            f"Combat: P1 lost {format_losses(p1_losses)} | P2 lost {format_losses(p2_losses)}"
        )


def casualties_from(attacker: Player, defender: Player) -> Dict[str, float]:
    """
    Compute losses inflicted by attacker on defender.
    """
    # Effectiveness coefficients attacker_type -> defender_type
    eff: Dict[str, Dict[str, float]] = {
        "arms": {"vehicles": 0.6, "aircraft": 0.1},
        "vehicles": {"arms": 0.7, "vehicles": 0.25},
        "tanks": {"vehicles": 0.8, "tanks": 0.5, "def_vehicle": 0.6, "def_arms": 0.4},
        "aircraft": {
            "tanks": 1.25,
            "vehicles": 2.4,  # strong vs IFVs/vehicles
            "aircraft": 0.7,
            "def_air": 0.35,
            "def_vehicle": 0.38,  # still slowed by defenses
            "def_arms": 0.25,
            "arms": 0.25,
            "missiles": 0.7,
        },
        "helicopters": {
            "arms": 1.0,
            "vehicles": 1.4,
            "tanks": 0.9,
            "helicopters": 0.6,
            "aircraft": 0.2,
            "def_air": 0.55,
            "def_vehicle": 0.35,
            "missiles": 0.4,
        },
        "missiles": {
            "def_air": 0.45,
            "def_vehicle": 0.5,
            "def_arms": 0.35,
            "vehicles": 0.25,
            "arms": 0.2,
            "helicopters": 0.2,
        },
        "def_arms": {"arms": 0.9},
        "def_vehicle": {"vehicles": 0.95, "helicopters": 0.35},
        "def_air": {"aircraft": 1.2, "helicopters": 1.0, "missiles": 0.7},
    }

    attacker_counts = {
        "arms": attacker.arms,
        "vehicles": attacker.vehicles,
        "tanks": attacker.tanks,
        "aircraft": attacker.aircraft,
        "def_arms": attacker.def_arms,
        "def_vehicle": attacker.def_vehicle,
        "def_air": attacker.def_air,
        "helicopters": attacker.helicopters,
        "missiles": attacker.missile_launchers,
    }
    losses: Dict[str, float] = {k: 0.0 for k in attacker_counts.keys()}

    for atk_type, atk_count in attacker_counts.items():
        if atk_count <= 0:
            continue
        for def_type, coeff in eff.get(atk_type, {}).items():
            if hasattr(defender, def_type):
                losses[def_type] += atk_count * coeff * COMBAT_SCALE

    return {k: v for k, v in losses.items() if v > 0}


def format_losses(losses: Dict[str, float]) -> str:
    if not losses:
        return "no losses"
    return ", ".join(f"{k}:{v:.1f}" for k, v in sorted(losses.items()))


def missile_penalty_value(attacker: Player, frontline_pos: float) -> float:
    if attacker.missile_launchers <= 0:
        return 0.0
    base_penalty = min(attacker.missile_launchers * MISSILE_LOGI_PENALTY_PER, MISSILE_LOGI_PENALTY_CAP)
    # Strongest in the central contested zone; weaker at the map edges.
    proximity = clamp(1.0 - abs((frontline_pos - 50.0) / 50.0), 0.0, 1.0)
    return base_penalty * proximity


def apply_armored_factory(player: Player, vehicle_boost: float, tank_boost: float, key: int) -> None:
    player.vehicle_prod += vehicle_boost
    player.tank_bonus += tank_boost
    projected = dict(player.purchases)
    projected[key] = projected.get(key, 0) + 1
    maybe_apply_armor_synergy(player, projected)
    maybe_update_missile_prereq(player)


def maybe_apply_armor_synergy(player: Player, projected_purchases: Optional[Dict[int, int]] = None) -> None:
    if player.armored_synergy_bonus:
        return
    purchases = projected_purchases or player.purchases
    if purchases.get(1, 0) > 0 and purchases.get(9, 0) > 0:
        player.armored_synergy_bonus = True
        player.logistics_health = clamp(player.logistics_health + 5, 10.0, 250.0)
        player.defense_prod += 3
        maybe_update_missile_prereq(player)


def unlock_missiles(player: Player) -> None:
    if player.missile_unlocked:
        return
    if not missile_authorization_allowed(player):
        raise ValueError("Missile unlock requires armor plants or Aircraft Works + 3 Helipads.")
    player.missile_unlocked = True


def add_helipad(player: Player) -> None:
    if player.purchases.get(4, 0) <= 0:
        raise ValueError("Helipads require owning an Aircraft Works.")
    player.helipads += 1
    player.helicopters += 5
    player.arms_prod = round(player.arms_prod * 1.05, 2)
    maybe_update_missile_prereq(player)


def missile_authorization_allowed(player: Player) -> bool:
    armor_path = player.purchases.get(1, 0) > 0 and player.purchases.get(9, 0) > 0
    air_path = player.purchases.get(4, 0) > 0 and player.helipads >= 3
    return armor_path or air_path


def maybe_update_missile_prereq(player: Player) -> None:
    """
    If the player reaches the air route prereqs (Aircraft Works + 3 helipads),
    mark the missile unlock flag so they can immediately build launchers.
    """
    if player.missile_unlocked:
        return
    if missile_authorization_allowed(player):
        player.missile_unlocked = True


def compute_frontline_pressure(attacker: Player, defender: Player) -> Tuple[float, Dict[str, float]]:
    """
    Convert force advantages into a pressure score that can crack the front line.
    Positive values favor the attacker; negative values stall progress.
    """
    armor_strength = attacker.vehicles + attacker.tanks * 1.2
    armor_resistance = defender.vehicles + defender.tanks * 1.1 + defender.def_vehicle * 0.5
    armor_superiority = (armor_strength - armor_resistance) * 0.25

    infantry_push = attacker.arms + attacker.def_arms * 0.4
    infantry_wall = defender.arms + defender.def_arms * 0.6
    infantry_density = (infantry_push - infantry_wall) * 0.2

    air_push = attacker.aircraft * 1.05 + attacker.helicopters * 0.8
    air_denial = defender.aircraft + defender.helicopters * 0.6 + defender.def_air * 1.0
    air_support = (air_push - air_denial) * 0.25

    enemy_defenses = -(defender.def_vehicle * 0.04 + defender.def_arms * 0.04 + defender.def_air * 0.04)
    logistics_penalty = -max(0.0, (100.0 - attacker.logistics_health) / 14.0)

    components = {
        "Armor Superiority": armor_superiority,
        "Infantry Density": infantry_density,
        "Air Support": air_support,
        "Enemy Defenses": enemy_defenses,
        "Logistics Penalty": logistics_penalty,
    }
    net = sum(components.values())
    return net, components


def format_pressure_components(components: Dict[str, float]) -> str:
    return ", ".join(f"{name} {value:+.1f}" for name, value in components.items())


def update_pressure_progress(current: float, pushing_net: float, opposing_net: float) -> float:
    """
    Apply decay, attacker pressure, and opposing bleed to a pressure progress meter.
    """
    progress = max(0.0, current - FRONTLINE_PRESSURE_DECAY)
    progress += pushing_net
    if opposing_net > 0:
        progress -= opposing_net * FRONTLINE_OPPOSING_BLEED
    return clamp(progress, 0.0, FRONTLINE_PRESSURE_THRESHOLD * 1.5)


def apply_breakthrough_attrition(state: GameState) -> None:
    """
    When a frontline segment is taken, both sides lose 75% of all unit pools to reflect the costly push.
    """
    for player in (state.player1, state.player2):
        for attr in ("arms", "vehicles", "tanks", "aircraft", "helicopters", "def_arms", "def_vehicle", "def_air", "missile_launchers"):
            current = getattr(player, attr, 0.0)
            setattr(player, attr, round(current * 0.25, 2))
    state.record("Breakthrough attrition: both sides reduced to 25% of prior frontline forces.")


def apply_frontline_pressure(state: GameState, p1_net: float, p2_net: float) -> None:
    """
    Update pressure meters and move the front line in discrete 25% jumps.
    """
    state.pressure_toward_p2 = update_pressure_progress(state.pressure_toward_p2, p1_net, p2_net)
    state.pressure_toward_p1 = update_pressure_progress(state.pressure_toward_p1, p2_net, p1_net)

    moves = []
    if state.pressure_toward_p2 >= FRONTLINE_PRESSURE_THRESHOLD:
        moves.append(("p1", p1_net))
    if state.pressure_toward_p1 >= FRONTLINE_PRESSURE_THRESHOLD:
        moves.append(("p2", p2_net))

    if not moves:
        return

    # Resolve simultaneous breakthroughs by taking the stronger net push.
    mover, mover_net = max(moves, key=lambda item: item[1])
    if mover == "p1":
        state.frontline = clamp(state.frontline + FRONTLINE_SEGMENT, FRONTLINE_MIN, FRONTLINE_MAX)
        state.record(
            f"{state.player1.name} broke through! Front line advanced to {state.frontline_ratio:.0f}% "
            f"(progress reset)."
        )
    else:
        state.frontline = clamp(state.frontline - FRONTLINE_SEGMENT, FRONTLINE_MIN, FRONTLINE_MAX)
        state.record(
            f"{state.player2.name} counter-broke! Front line pushed back to {state.frontline_ratio:.0f}% "
            f"(progress reset)."
        )

    # Major breakthrough attrition: both sides lose 75% of current troops before the next buildup.
    apply_breakthrough_attrition(state)

    check_victory(state)
    if state.winner:
        state.record(
            f"{state.winner} reached the front-line limit ({state.frontline_ratio:.0f}%). "
            f"Final pressure meters P1->P2 {state.pressure_toward_p2:.1f}, "
            f"P2->P1 {state.pressure_toward_p1:.1f}."
        )
    else:
        # Reset pressure after a breakthrough to force a fresh buildup when game continues.
        state.pressure_toward_p2 = 0.0
        state.pressure_toward_p1 = 0.0


def check_victory(state: GameState) -> None:
    if state.winner:
        return
    if state.frontline <= FRONTLINE_MIN:
        state.winner = state.player2.name
        state.frontline = FRONTLINE_MIN
    elif state.frontline >= FRONTLINE_MAX:
        state.winner = state.player1.name
        state.frontline = FRONTLINE_MAX


def buy_factory(
    state: GameState, player_key: str, factory_id: int, factories: Dict[int, Factory], quantity: int = 1
) -> str:
    player = state.player1 if player_key.lower() in ("1", "p1", "player1") else state.player2
    if factory_id not in factories:
        raise ValueError(f"Factory {factory_id} is not in the store.")
    if quantity <= 0:
        raise ValueError("Quantity must be at least 1.")

    factory = factories[factory_id]
    if factory.key == 10 and not missile_authorization_allowed(player):
        raise ValueError("Missile Corps Authorization requires armor plants or Aircraft Works + 3 Helipads.")
    if factory.key == 11 and not player.missile_unlocked:
        raise ValueError("Buy Missile Corps Authorization before purchasing launchers.")
    if factory.key == 12 and player.purchases.get(4, 0) <= 0:
        raise ValueError("Helipads require Aircraft Works.")

    total_cost = factory.cost * quantity
    if player.credits < total_cost:
        raise ValueError(
            f"{player.name} lacks credits ({player.credits}) for {quantity}x {factory.name} (cost {total_cost})."
        )

    # Queue builds respecting capacity
    for _ in range(quantity):
        player.queue_build(factory)
    player.credits -= total_cost

    plural = "factory" if quantity == 1 else "factories"
    state.record(f"{player.name} queued {quantity} {factory.name} {plural} (build) for {total_cost} credits.")
    return f"{player.name} queued {quantity}x {factory.name}. Remaining credits: {player.credits}"


def render_bar(label: str, value: float, maximum: float, width: int = 22) -> str:
    value_clamped = clamp(value, 0.0, maximum)
    filled = int(round((value_clamped / maximum) * width))
    empty = width - filled
    bar = "█" * filled + "·" * empty
    return f"{label:<14} [{bar}] {value:.1f}/{maximum}"


def render_frontline_bar(ratio_percent: float, width: int = 30) -> str:
    ratio_clamped = clamp(ratio_percent, 0.0, 100.0)
    filled = int(round((ratio_clamped / 100.0) * width))
    empty = width - filled
    bar = "█" * filled + "·" * empty
    return f"Front line      [{bar}] {ratio_clamped:.1f}%"


def render_history(history: List[str], limit: int = 10) -> str:
    if not history:
        return "No history yet."
    recent = history[-limit:]
    return "Recent events:\n" + "\n".join(f" - {item}" for item in recent)


def show_status(state: GameState) -> str:
    lines = [
        render_frontline_bar(state.frontline_ratio),
        render_bar("Pressure P1->P2", state.pressure_toward_p2, FRONTLINE_PRESSURE_THRESHOLD),
        render_bar("Pressure P2->P1", state.pressure_toward_p1, FRONTLINE_PRESSURE_THRESHOLD),
        f"Missile logistics penalty -> P1 {state.player1.logistics_penalty:.1f}, "
        f"-> P2 {state.player2.logistics_penalty:.1f}",
        "",
        describe_player(state.player1),
        "",
        describe_player(state.player2),
    ]
    if state.sorties:
        lines.append(f"Active sorties: {len(state.sorties)} (aircraft away from frontline until they resolve)")
    if state.winner:
        lines.append(f"🏁 {state.winner} controls the front line. Game over.")
    return "\n".join(lines)


