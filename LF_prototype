    def _init_visualization(self) -> None:
        self.canvas.delete("all")
        self.canvas.configure(bg="#0b1612")
        width = int(self.canvas.cget("width"))
        height = int(self.canvas.cget("height"))
        ground_y = height - 40
        self._draw_map_background(width, height, ground_y)
        self.base_icons = [
            self.canvas.create_oval(20, ground_y - 80, 80, ground_y - 20, fill="#1b5fc1", outline=""),
            self.canvas.create_oval(width - 80, ground_y - 80, width - 20, ground_y - 20, fill="#c12c2c", outline=""),
        ]
        self.obstacles = self._build_obstacles(width, ground_y)
        self._render_structures()
        self.frontline_line_id = self.canvas.create_line(
            self._frontline_x(width),
            10,
            self._frontline_x(width),
            ground_y,
            fill="#d3d7de",
            width=2,
            dash=(4, 4),
        )
        self.canvas.create_text(40, 24, text="P1 Base", fill="#b7e1ff", anchor="w", font=("TkFixedFont", 11, "bold"))
        self.canvas.create_text(width - 40, 24, text="P2 Base", fill="#ffd8d8", anchor="e", font=("TkFixedFont", 11, "bold"))
        # Curved lanes for marching dots
        self.lanes = self._build_lanes(height)

    def _frontline_x(self, width: int) -> float:
        return FRONTLINE_MIN + (self.state.frontline_ratio / 100.0) * width

    def _spawn_dots(self) -> None:
        width = int(self.canvas.cget("width"))
        height = int(self.canvas.cget("height"))
        ground_y = height - 50
        spawn_band = (40, ground_y - 20)
        # Spawn proportional to production (excluding air defense) and logistics, capped for performance.
        p1_spawn = self._spawn_count(self.state.player1)
        p2_spawn = self._spawn_count(self.state.player2)
        for _ in range(p1_spawn):
            y = random.randint(*spawn_band)
            kind = self._choose_kind(self.state.player1)
            lane = random.choice(self.lanes)
            start_x = 60.0 if kind not in ("aircraft", "helicopter") else self._airfield_x("p1")
            self.dots.append(
                {
                    "start": start_x,
                    "progress": 0.0,
                    "y": float(y),
                    "dir": 1,
                    "speed": self._speed_for_kind(kind),
                    "side": "p1",
                    "lane": lane,
                    "kind": kind,
                    "phase": "outbound",
                }
            )
        for _ in range(p2_spawn):
            y = random.randint(*spawn_band)
            kind = self._choose_kind(self.state.player2)
            lane = random.choice(self.lanes)
            start_x = float(width - 60) if kind not in ("aircraft", "helicopter") else self._airfield_x("p2")
            self.dots.append(
                {
                    "start": start_x,
                    "progress": 0.0,
                    "y": float(y),
                    "dir": -1,
                    "speed": self._speed_for_kind(kind),
                    "side": "p2",
                    "lane": lane,
                    "kind": kind,
                    "phase": "outbound",
                }
            )
        # Trim to avoid runaway counts.
        if len(self.dots) > 400:
            self.dots = self.dots[-400:]

    def _spawn_count(self, player: Player) -> int:
        effective_prod = (player.vehicle_prod + player.arms_prod + player.aircraft_prod) * player.logistics_factor
        return clamp(int(effective_prod / 40), 1, 8)

    def _resolve_dot_collisions(self) -> None:
        survivors: List[Dict[str, float]] = []
        grid: Dict[int, Dict[int, Dict[str, float]]] = {}
        cell_size = 10
        for dot in self.dots:
            cell_x = int(dot["x"] // cell_size)
            cell_y = int(dot["y"] // cell_size)
            key = (cell_x, cell_y)
            bucket = grid.setdefault(key, {})
            if bucket and bucket.get("side") != dot["side"]:
                # Collision only across sides
                bucket.clear()
            else:
                bucket["dot"] = dot
                bucket["side"] = dot["side"]
        for bucket in grid.values():
            dot = bucket.get("dot")
            if dot:
                survivors.append(dot)
        self.dots = survivors
        if self.effects:
            self.effects = [eff for eff in self.effects if eff.get("ttl", 0) > 0]

    def _step_dots(self) -> None:
        width = int(self.canvas.cget("width"))
        travel = width - 120
        next_dots: List[Dict[str, float]] = []
        for dot in self.dots:
            dot["progress"] += dot["speed"]
            lane = dot["lane"]
            base_x = dot["start"] + dot["dir"] * dot["progress"]
            sway = math.sin((dot["progress"] / lane["period"]) + lane["phase"]) * lane["amplitude"]
            candidate_x = base_x
            candidate_y = lane["y"] + sway
            if dot["kind"] not in ("aircraft", "helicopter"):
                for obs in self.obstacles:
                    if obs["x1"] <= candidate_x <= obs["x2"] and obs["y1"] <= candidate_y <= obs["y2"]:
                        # divert vertically around the obstacle
                        if candidate_y < (obs["y1"] + obs["y2"]) / 2:
                            candidate_y = obs["y1"] - 5
                        else:
                            candidate_y = obs["y2"] + 5
            dot["x"] = candidate_x
            dot["y"] = candidate_y
            if dot["kind"] in ("aircraft", "helicopter"):
                target_x = self._frontline_x(width)
                reached_target = (dot["dir"] == 1 and candidate_x >= target_x) or (dot["dir"] == -1 and candidate_x <= target_x)
                if dot["phase"] == "outbound" and reached_target:
                    # Impact effect
                    self.effects.append({"x": target_x, "y": candidate_y, "ttl": 18})
                    dot["phase"] = "return"
                    dot["dir"] *= -1
                    dot["start"] = candidate_x
                    dot["progress"] = 0.0
            if dot["phase"] == "return" and dot["progress"] > travel / 2:
                # Landed
                continue
            next_dots.append(dot)
        self.dots = next_dots

    def _render_dots(self) -> None:
        width = int(self.canvas.cget("width"))
        height = int(self.canvas.cget("height"))
        ground_y = height - 40
        self.canvas.delete("dot")
        if self.frontline_line_id:
            self.canvas.coords(
                self.frontline_line_id,
                self._frontline_x(width),
                10,
                self._frontline_x(width),
                ground_y,
            )
        for dot in self.dots:
            self._draw_unit_sprite(dot)

    def _animate(self) -> None:
        self._spawn_dots()
        self._step_dots()
        self._resolve_dot_collisions()
        self._render_dots()
        self._render_effects()
        self.root.after(30, self._animate)

    def _draw_unit_sprite(self, dot: Dict[str, float]) -> None:
        kind = dot["kind"]
        side = dot["side"]
        color = self._color_for_kind(kind, side)
        outline = "#0a0a0a"
        scale = self._size_for_kind(kind)
        cx, cy = dot["x"], dot["y"]
        points = []
        if kind in ("tank", "vehicle"):
            body = [(-1.2, -0.5), (1.4, -0.5), (1.6, 0.0), (1.4, 0.5), (-1.2, 0.5), (-1.4, 0.0)]
            turret = [(-0.2, -0.2), (0.8, -0.2), (0.8, 0.2), (-0.2, 0.2)]
            gun = [(0.8, -0.05), (1.6, -0.05), (1.6, 0.05), (0.8, 0.05)]
            for poly in (body, turret, gun):
                pts = []
                for x, y in poly:
                    pts.extend([cx + x * scale, cy + y * scale])
                self.canvas.create_polygon(pts, fill=color, outline=outline, width=1, tags="dot")
            return
        if kind == "infantry":
            body = [(-0.6, -0.8), (0.6, -0.8), (0.6, 0.8), (-0.6, 0.8)]
            pts = []
            for x, y in body:
                pts.extend([cx + x * scale, cy + y * scale])
            self.canvas.create_polygon(pts, fill=color, outline=outline, width=1, tags="dot")
            self.canvas.create_line(cx, cy - 0.8 * scale, cx, cy - 1.5 * scale, fill=color, width=2, tags="dot")
            return
        if kind in ("aircraft", "helicopter"):
            nose = (1.5, 0.0)
            tail = (-1.2, 0.0)
            wing1 = (0.2, 0.8)
            wing2 = (0.2, -0.8)
            pts = []
            for x, y in (nose, wing1, tail, wing2):
                pts.extend([cx + x * scale, cy + y * scale])
            self.canvas.create_polygon(pts, fill=color, outline=outline, width=1, tags="dot")
            if kind == "helicopter":
                self.canvas.create_oval(
                    cx - 1.0 * scale,
                    cy - 1.0 * scale,
                    cx + 1.0 * scale,
                    cy + 1.0 * scale,
                    outline=color,
                    width=2,
                    tags="dot",
                )
            return
        if kind == "missile":
            body = [(-0.6, -0.2), (1.2, -0.2), (1.4, 0.0), (1.2, 0.2), (-0.6, 0.2)]
            tail1 = [(-0.6, -0.2), (-0.9, -0.5), (-0.6, -0.5)]
            tail2 = [(-0.6, 0.2), (-0.9, 0.5), (-0.6, 0.5)]
            for poly in (body, tail1, tail2):
                pts = []
                for x, y in poly:
                    pts.extend([cx + x * scale, cy + y * scale])
                self.canvas.create_polygon(pts, fill=color, outline=outline, width=1, tags="dot")
            return
        # fallback dot
        self.canvas.create_oval(cx - scale, cy - scale, cx + scale, cy + scale, fill=color, outline="", tags="dot")

    def _render_effects(self) -> None:
        if not self.effects:
            return
        self.canvas.delete("effect")
        survivors: List[Dict[str, float]] = []
        for eff in self.effects:
            r = max(4, eff.get("ttl", 0) // 2)
            self.canvas.create_oval(
                eff["x"] - r,
                eff["y"] - r,
                eff["x"] + r,
                eff["y"] + r,
                outline="#ffd36f",
                width=2,
                tags="effect",
            )
            eff["ttl"] -= 1
            if eff["ttl"] > 0:
                survivors.append(eff)
        self.effects = survivors

    def _draw_map_background(self, width: int, height: int, ground_y: int) -> None:
        self.canvas.create_rectangle(0, 0, width, height, fill="#0b1612", outline="")
        # Grid lines
        for x in range(0, width, 40):
            self.canvas.create_line(x, 0, x, height, fill="#143021", width=1, tags="map")
        for y in range(0, height, 40):
            self.canvas.create_line(0, y, width, y, fill="#143021", width=1, tags="map")
        # Landmass shapes
        land_colors = ("#123e2c", "#1a4d36")
        random.seed(42)
        for _ in range(6):
            cx = random.randint(80, width - 80)
            cy = random.randint(60, ground_y - 60)
            points = []
            radius = random.randint(60, 140)
            for i in range(8):
                angle = (math.pi * 2 * i) / 8
                r = radius * random.uniform(0.6, 1.1)
                points.extend([cx + math.cos(angle) * r, cy + math.sin(angle) * r])
            self.canvas.create_polygon(points, fill=random.choice(land_colors), outline="")
        self.canvas.create_rectangle(0, ground_y, width, height, fill="#0c141a", outline="")
        # Airfields near bases
        self.canvas.create_rectangle(20, ground_y - 24, 120, ground_y - 8, fill="#1f2e2a", outline="#4a5b50", tags="map")
        self.canvas.create_rectangle(width - 120, ground_y - 24, width - 20, ground_y - 8, fill="#2e1f1f", outline="#5b4a4a", tags="map")

    def _build_lanes(self, height: int) -> List[Dict[str, float]]:
        lanes: List[Dict[str, float]] = []
        base_y_positions = [height * 0.35, height * 0.45, height * 0.55, height * 0.65]
        for base_y in base_y_positions:
            amplitude = random.uniform(6.0, 14.0)
            period = random.uniform(55.0, 95.0)
            phase = random.uniform(0, math.pi * 2)
            lanes.append({"y": base_y, "amplitude": amplitude, "period": period, "phase": phase})
        return lanes

    def _build_obstacles(self, width: int, ground_y: int) -> List[Dict[str, float]]:
        obstacles: List[Dict[str, float]] = []
        random.seed(7)
        for _ in range(6):
            w = random.randint(30, 60)
            h = random.randint(24, 48)
            x1 = random.randint(140, width - 200)
            y1 = random.randint(80, int(ground_y - 120))
            x2 = x1 + w
            y2 = y1 + h
            obstacles.append({"x1": x1, "y1": y1, "x2": x2, "y2": y2})
            self.canvas.create_rectangle(x1, y1, x2, y2, fill="#4a5b50", outline="#2a3a30", width=2, tags="obstacle")
        return obstacles

    def _airfield_x(self, side: str) -> float:
        width = int(self.canvas.cget("width"))
        return 70.0 if side == "p1" else float(width - 70)

    def _render_structures(self) -> None:
        for item in self.structure_icons:
            self.canvas.delete(item)
        self.structure_icons = []
        width = int(self.canvas.cget("width"))
        ground_y = int(self.canvas.cget("height")) - 40
        icon_size = 10
        spacing = 16
        for idx, (factory_id, factory) in enumerate(sorted(FACTORIES_LOOKUP.items())):
            # Place structures near respective bases; repeated purchases stack icons.
            x_left = 30
            x_right = width - 30
            y_base = 40 + idx * spacing
            for n in range(self.state.player1.purchases.get(factory_id, 0)):
                self.structure_icons.append(
                    self.canvas.create_rectangle(
                        x_left - icon_size,
                        y_base - icon_size,
                        x_left + icon_size,
                        y_base + icon_size,
                        outline="#9ad69a",
                        fill="#1b3326",
                        tags="structure",
                    )
                )
            for n in range(self.state.player2.purchases.get(factory_id, 0)):
                self.structure_icons.append(
                    self.canvas.create_rectangle(
                        x_right - icon_size,
                        y_base - icon_size,
                        x_right + icon_size,
                        y_base + icon_size,
                        outline="#ff9a7b",
                        fill="#3b1f1f",
                        tags="structure",
                    )
                )
            self.structure_icons.append(
                self.canvas.create_text(
                    x_left + 20,
                    y_base,
                    text=factory.name,
                    anchor="w",
                    fill="#9ad69a",
                    font=("TkFixedFont", 8),
                    tags="structure",
                )
            )
    def _choose_kind(self, player: Player) -> str:
        weights = {
            "tank": player.tanks,
            "vehicle": player.vehicles,
            "infantry": player.arms,
            "aircraft": player.aircraft,
            "helicopter": player.helicopters,
            "missile": player.missile_launchers,
        }
        total = sum(weights.values())
        if total <= 0:
            return "infantry"
        pick = random.uniform(0, total)
        cumulative = 0.0
        for kind, val in weights.items():
            cumulative += val
            if pick <= cumulative:
                return kind
        return "infantry"

    def _speed_for_kind(self, kind: str) -> float:
        base = {"infantry": 1.1, "vehicle": 1.5, "tank": 1.35, "aircraft": 2.6, "helicopter": 2.1, "missile": 1.4}
        return base.get(kind, 1.2)

    def _size_for_kind(self, kind: str) -> float:
        sizes = {"infantry": 3.0, "vehicle": 4.5, "tank": 5.0, "aircraft": 4.0, "helicopter": 3.8, "missile": 3.5}
        return sizes.get(kind, 3.0)

    def _color_for_kind(self, kind: str, side: str) -> str:
        base = {
            "infantry": "#9ad69a",
            "vehicle": "#7fb0ff",
            "tank": "#4fa3ff",
            "aircraft": "#ffd36f",
            "helicopter": "#ffb347",
            "missile": "#d6a0ff",
        }
        shade = base.get(kind, "#9ad69a")
        if side == "p2":
            # Tint red-ish for player 2
            return "#ff7b7b" if kind in ("infantry", "missile") else "#ff9a7b"
        return shade

    def _refresh_store(self) -> None:
        self.store_text.configure(state="normal")
        self.store_text.delete("1.0", "end")
        self.store_text.insert("1.0", describe_store(self.factories))
        self.store_text.configure(state="disabled")

    def update_status(self) -> None:
        self.frontline_pct.set(self.state.frontline_ratio)
        self.frontline_label.set(f"{self.state.frontline_ratio:.1f}%")
        self.pressure_p1.set(self.state.pressure_toward_p2)
        self.pressure_p2.set(self.state.pressure_toward_p1)
        self.pressure_label.set(
            f"P1➜P2 {self.state.pressure_toward_p2:.1f}/{FRONTLINE_PRESSURE_THRESHOLD} | "
            f"P2➜P1 {self.state.pressure_toward_p1:.1f}/{FRONTLINE_PRESSURE_THRESHOLD}"
        )
        self.logi_penalty_label.set(
            f"Missile logistics penalty: P1 {self.state.player1.logistics_penalty:.1f} | "
            f"P2 {self.state.player2.logistics_penalty:.1f}"
        )

        self._update_player_panel(self.p1_panel, self.state.player1)
        self._update_player_panel(self.p2_panel, self.state.player2)

        active_sorties = len(self.state.sorties)
        if active_sorties:
            self.sortie_label.set(f"Active sorties: {active_sorties} aircraft groups away from the front.")
        else:
            self.sortie_label.set("")

        self.history_text.configure(state="normal")
        self.history_text.delete("1.0", "end")
        self.history_text.insert("1.0", render_history(self.state.history, limit=12))
        self.history_text.configure(state="disabled")

    def _update_player_panel(self, panel: Dict[str, tk.Variable], player: Player) -> None:
        panel["credits"].set(f"{player.name}: {player.credits} credits (Income: {player.income_this_tick()})")
        panel["logi_bar"].set(player.logistics_health)
        panel["logi_text"].set(f"Logistics {player.logistics_health:.1f} (factor {player.logistics_factor:.2f})")
        panel["production"].set(
            f"Output -> Veh {player.vehicle_prod:.1f} | Arms {player.arms_prod:.1f} | "
            f"Air {player.aircraft_prod:.1f} | Def {player.defense_prod:.1f} | "
            f"Total {player.total_production:.1f}"
        )
        panel["units"].set(
            "Ground: INF {inf:.1f} | IFV {veh:.1f} | TANK {tank:.1f}\n"
            "Air: AC {air:.1f} | HELI {heli:.1f} | MISS {miss:.1f}\n"
            "Def: AR {defa:.1f} | VEH {defv:.1f} | AIR {defair:.1f}".format(
                inf=player.arms,
                veh=player.vehicles,
                tank=player.tanks,
                air=player.aircraft,
                heli=player.helicopters,
                miss=player.missile_launchers,
                defa=player.def_arms,
                defv=player.def_vehicle,
                defair=player.def_air,
            )
        )
        queue_details = (
            ", ".join(f"{bo.factory.name} ({bo.remaining}t)" for bo in player.build_queue) or "empty"
        )
        panel["build"].set(f"Slots {player.build_capacity()} | Queue {len(player.build_queue)}/{BUILD_QUEUE_MAX} -> {queue_details}")
        panel["purchases"].set(
            ", ".join(
                f"{FACTORIES_LOOKUP[factory_id].name} x{count}"
                for factory_id, count in sorted(player.purchases.items())
                if count > 0
            )
            or "No structures yet"
        )

    def handle_single_tick(self) -> None:
        self.handle_multiple_ticks(1)

    def handle_multiple_ticks(self, count: int) -> None:
        try:
            for _ in range(count):
                advance_tick(self.state)
                if self.state.winner:
                    break
            self.update_status()
        except ValueError as exc:
            messagebox.showerror("Tick error", str(exc))

    def _selected_factory_id(self) -> int:
        selected = self.factory_var.get()
        if ":" not in selected:
            return 0
        return int(selected.split(":")[0])

    def handle_buy(self) -> None:
        factory_id = self._selected_factory_id()
        try:
            quantity = int(self.quantity_var.get())
        except ValueError:
            quantity = 1
        player_key = "p1" if self.buy_player.get().lower().startswith("p1") else "p2"
        try:
            buy_factory(self.state, player_key, factory_id, self.factories, quantity)
            self.update_status()
        except ValueError as exc:
            messagebox.showerror("Purchase failed", str(exc))

    def handle_sortie(self) -> None:
        player_key = "p1" if self.sortie_player.get().lower().startswith("p1") else "p2"
        try:
            launch_sortie(self.state, player_key, self.sortie_size.get(), self.sortie_target.get())
            self.update_status()
        except ValueError as exc:
            messagebox.showerror("Sortie failed", str(exc))

    def run(self) -> None:
        self.root.mainloop()


def run_gui(state: GameState, factories: Dict[int, Factory]) -> None:
    ui = GameUI(state, factories)
    ui.run()


def print_help() -> str:
    return (
        "Commands:\n"
        "  status | s              -> show both players and the front line\n"
        "  store                   -> list factories and effects\n"
        "  buy <p1|p2> <id> [n|max]-> queue factory builds (single, n copies, or max affordable)\n"
        "  a <p1|p2> <size> <tgt>  -> launch air sortie (size: small/med/large, tgt: vehicles/arms/air/def/logi)\n"
        "  tick [n]                -> advance the simulation by n ticks (default 1)\n"
        "  log                     -> show recent events\n"
        "  help                    -> show this message\n"
        "  quit                    -> exit\n"
    )


def interactive_loop(state: GameState, factories: Dict[int, Factory]) -> None:
    print("Logistics & Production tug-of-war. Type 'help' for commands.")
    print(show_status(state))

    while True:
        try:
            raw = input("\ncommand> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nExiting.")
            break

        if not raw:
            continue
        parts = raw.split()
        cmd = parts[0].lower()

        try:
            if cmd in ("quit", "exit", "q"):
                print("Goodbye.")
                break
            if cmd == "help":
                print(print_help())
            elif cmd in ("status", "s"):
                print(show_status(state))
            elif cmd == "store":
                print(describe_store(factories))
            elif cmd == "log":
                print(render_history(state.history))
            elif cmd == "buy":
                if len(parts) < 3:
                    print("Usage: buy <p1|p2> <factory_id> [n|max]")
                    continue
                if state.winner:
                    print("Game is over. No more purchases.")
                    continue
                quantity = 1
                if len(parts) >= 4:
                    if parts[3].lower() == "max":
                        factory_id = int(parts[2])
                        if factory_id not in factories:
                            print(f"Factory {factory_id} is not in the store.")
                            continue
                        factory = factories[factory_id]
                        player = state.player1 if parts[1].lower() in ("1", "p1", "player1") else state.player2
                        quantity = max(1, player.credits // factory.cost)
                    else:
                        quantity = int(parts[3])
                message = buy_factory(state, parts[1], int(parts[2]), factories, quantity)
                print(message)
            elif cmd == "a":
                if state.winner:
                    print(f"Game is over. {state.winner} already controls the front line.")
                    continue
                if len(parts) != 4:
                    print("Usage: a <p1|p2> <small|med|large> <vehicles|arms|air|def|logi>")
                    continue
                try:
                    message = launch_sortie(state, parts[1], parts[2], parts[3])
                    print(message)
                except ValueError as exc:
                    print(f"Error: {exc}")
            elif cmd == "tick":
                if state.winner:
                    print(f"Game is over. {state.winner} already controls the front line.")
                    continue
                ticks = int(parts[1]) if len(parts) > 1 else 1
                for _ in range(max(1, ticks)):
                    advance_tick(state)
                    if state.winner:
                        break
                print(show_status(state))
            else:
                print("Unknown command. Type 'help' for options.")
        except ValueError as exc:
            print(f"Error: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Two-player logistics & production tug-of-war.")
    parser.add_argument(
        "--ticks",
        type=int,
        default=0,
        help="If set, run this many ticks non-interactively then print status and exit.",
    )
    parser.add_argument(
        "--gui",
        action="store_true",
        help="Launch a Tkinter interface for interactive play.",
    )
    args = parser.parse_args()

    global FACTORIES_LOOKUP
    factories = make_factories()
    FACTORIES_LOOKUP = factories
    state = GameState(player1=Player("Player 1"), player2=Player("Player 2"))

    if args.gui:
        run_gui(state, factories)
    elif args.ticks > 0:
        for _ in range(max(1, args.ticks)):
            advance_tick(state)
            if state.winner:
                break
        print(show_status(state))
        print()
        print(render_history(state.history))
    else:
        interactive_loop(state, factories)


if __name__ == "__main__":
    main()
